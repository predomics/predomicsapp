# PredomicsApp — NGINX reverse proxy, HTTPS mode (NGINX_MODE=https, default)
#
# This is a template: the nginx image substitutes ${DOMAIN}, ${NGINX_MAX_BODY}
# and ${NGINX_TRUSTED_PROXY} from the container environment at start-up and
# writes the result to /etc/nginx/conf.d/default.conf. Nginx variables ($host, …)
# are left untouched. Do not edit the rendered file; edit this template.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Access-log format without the query string (used for /ws/, whose query
# carries a credential).
log_format predomics_noargs '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                            '"$http_referer" "$http_user_agent"';

# Proxies in front of this nginx whose X-Forwarded-For is believed
# (NGINX_TRUSTED_PROXY, an address or CIDR; default: none besides localhost).
set_real_ip_from ${NGINX_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# HTTP → HTTPS redirect
server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — main server block
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # SSL certificates (managed by certbot; nginx reloads every 6 h, see
    # 40-reload-certs.sh, so renewed certificates are picked up)
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    set $predomics_hsts "max-age=31536000; includeSubDomains";
    set $predomics_forwarded_proto https;
    include /etc/nginx/predomics/security-headers.conf;

    # Upload and timeout settings
    client_max_body_size  ${NGINX_MAX_BODY};
    proxy_read_timeout    600s;
    proxy_send_timeout    600s;
    proxy_connect_timeout 10s;

    include /etc/nginx/predomics/locations.conf;
}
