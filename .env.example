# PredomicsApp — environment file
#
#   cp .env.example .env      (or run ./scripts/setup.sh, which writes it for you)
#
# Read by Docker Compose (variable substitution in the compose files) AND passed
# to the application container, so every PREDOMICS_* setting below takes effect.
# Full reference: DEPLOYMENT.md, section "Settings".
#
# Syntax: KEY=value. Quote values that contain spaces or JSON with single
# quotes. This is not a shell script.

# --------------------------------------------------------------------------
# Required for the production stack (docker-compose.prod.yml)
# --------------------------------------------------------------------------

# JWT signing key. Generate with: openssl rand -hex 32
# (The base stack works without it: the app then generates one and stores it in
# the data volume as .secret_key.)
PREDOMICS_SECRET_KEY=

# PostgreSQL password of the bundled database. Choose it BEFORE the first start:
# the database volume keeps the password it was created with.
POSTGRES_PASSWORD=

# Public host name (NGINX server_name, certificate, CORS origin)
DOMAIN=predomics.example.com

# https = TLS terminated by the bundled NGINX with Let's Encrypt (default)
# http  = plain HTTP, for use behind another TLS-terminating proxy
NGINX_MODE=https

# Email for Let's Encrypt expiry notices (NGINX_MODE=https)
CERTBOT_EMAIL=admin@example.com

# --------------------------------------------------------------------------
# Accounts
# --------------------------------------------------------------------------

# The account with this email gets administrator rights (when it registers, or
# at the next start if it already exists). This is how the first admin is made.
PREDOMICS_ADMIN_EMAIL=

# false = only administrators can create accounts
# PREDOMICS_REGISTRATION_ENABLED=true

# true = create the public demo account demo@predomics.com / demo at start-up.
# Never enable on an instance reachable from the internet.
# PREDOMICS_SEED_DEMO=false

# PREDOMICS_PASSWORD_MIN_LENGTH=8

# Session lifetime in minutes (default 480 = 8 hours). The web interface renews
# the session while it is in use; an idle one expires after this long.
# PREDOMICS_ACCESS_TOKEN_EXPIRE_MINUTES=480

# true = new accounts must confirm their email address before they can log in.
# Needs SMTP (below): the app refuses to start with this on and no SMTP host.
# PREDOMICS_REQUIRE_EMAIL_VERIFICATION=false

# Back-off after repeated failed logins (per account and per client address):
# after the free attempts each further failure doubles the wait, up to the cap.
# PREDOMICS_LOGIN_THROTTLE_ENABLED=true
# PREDOMICS_LOGIN_THROTTLE_FREE_ATTEMPTS=5
# PREDOMICS_LOGIN_THROTTLE_MAX_MINUTES=15

# --------------------------------------------------------------------------
# Uploads and analysis jobs
# --------------------------------------------------------------------------

# Per-file upload limit enforced by the app, and by NGINX (keep both in line)
# PREDOMICS_MAX_UPLOAD_MB=500
# NGINX_MAX_BODY=500M

# Jobs running at the same time (the others wait in a queue)
# PREDOMICS_MAX_CONCURRENT_JOBS=2

# Upper bound on the threads one job may use (0 = number of CPUs)
# PREDOMICS_MAX_THREADS_PER_JOB=0

# Stop a job after this many minutes (0 = no limit)
# PREDOMICS_JOB_TIMEOUT_MINUTES=0

# Jobs one user may run at the same time (0 = no per-user limit)
# PREDOMICS_MAX_JOBS_PER_USER=0

# After a restart, jobs that were running are marked failed (default). true =
# put them back in the queue and run them again from the start.
# PREDOMICS_REQUEUE_INTERRUPTED=false

# --------------------------------------------------------------------------
# Storage: quota and retention (all off by default — nothing is ever deleted
# automatically unless you set these)
# --------------------------------------------------------------------------

# Storage each user may use for datasets and job results, in MB (0 = unlimited)
# PREDOMICS_USER_QUOTA_MB=0

# Delete finished jobs (results, logs) older than this many days (0 = keep)
# PREDOMICS_JOB_RETENTION_DAYS=0

# Keep only the newest N archives made from the Admin page (0 = keep all)
# PREDOMICS_BACKUP_RETENTION_COUNT=0

# Resources of the app container in the production stack
# PREDOMICS_CPU_LIMIT=2.0
# PREDOMICS_MEMORY_LIMIT=4G

# --------------------------------------------------------------------------
# URLs (defaults are derived from DOMAIN in the production stack)
# --------------------------------------------------------------------------

# Allowed browser origins — a JSON array, in single quotes
# PREDOMICS_CORS_ORIGINS='["https://predomics.example.com"]'

# Base URL used in password-reset emails
# PREDOMICS_FRONTEND_URL=https://predomics.example.com

# --------------------------------------------------------------------------
# Database (default: the bundled PostgreSQL with POSTGRES_PASSWORD)
# --------------------------------------------------------------------------

# Only to use an external PostgreSQL server:
# PREDOMICS_DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/predomics

# --------------------------------------------------------------------------
# Optional: Email (SMTP) — enables self-service password reset and email
# verification. Port 587 or 25: STARTTLS; port 465: TLS from the first byte;
# PREDOMICS_SMTP_TLS=false: no encryption (local relay only). The server
# certificate is verified; for a private CA set SSL_CERT_FILE to its bundle.
# --------------------------------------------------------------------------

# PREDOMICS_SMTP_HOST=smtp.example.com
# PREDOMICS_SMTP_PORT=587
# PREDOMICS_SMTP_USER=noreply@example.com
# PREDOMICS_SMTP_PASSWORD='smtp-password'
# PREDOMICS_SMTP_FROM=noreply@example.com
# PREDOMICS_SMTP_TLS=true

# --------------------------------------------------------------------------
# Optional: Distributed computing (scitq)
# --------------------------------------------------------------------------

# PREDOMICS_SCITQ_SERVER=scitq.example.com:5000
# PREDOMICS_SCITQ_TOKEN=your-scitq-token
# PREDOMICS_SCITQ_CONTAINER=ghcr.io/predomics/predomicsapp:latest

# --------------------------------------------------------------------------
# Logs, metrics, error tracking
# --------------------------------------------------------------------------

# text (default) or json (one JSON object per line, with request ids)
# PREDOMICS_LOG_FORMAT=text
# PREDOMICS_LOG_LEVEL=INFO

# Prometheus metrics at GET /metrics, for scrapers presenting this bearer token.
# Empty = the endpoint does not exist. Generate with: openssl rand -hex 24
# PREDOMICS_METRICS_TOKEN=

# Error tracking; only used if the sentry-sdk package is added to the image
# PREDOMICS_SENTRY_DSN=

# false = do not serve the interactive API documentation (/api/docs)
# PREDOMICS_API_DOCS=true

# --------------------------------------------------------------------------
# Database schema upgrades
# --------------------------------------------------------------------------

# true (default): the app upgrades the database schema when it starts.
# false: it refuses to start on an out-of-date database; run
#   docker compose run --rm app python -m backend.app.migrate
# as a separate step of your deployment.
# PREDOMICS_AUTO_MIGRATE=true

# --------------------------------------------------------------------------
# Other application settings
# --------------------------------------------------------------------------

# Allow webhooks to call private/intranet addresses (off by default)
# PREDOMICS_WEBHOOK_ALLOW_PRIVATE=false

# PREDOMICS_RATE_LIMIT_ENABLED=true
# PREDOMICS_RATE_LIMIT_API=100/minute

# --------------------------------------------------------------------------
# Backups (production stack, "backup" service)
# --------------------------------------------------------------------------

# Cron expression, evaluated in UTC
# BACKUP_SCHEDULE='0 2 * * *'
BACKUP_RETENTION_DAYS=7
# URL fetched when a backup fails (monitoring / chat webhook)
# BACKUP_FAILURE_URL=
# Command run after a successful backup, e.g. to copy /backups off the host
# BACKUP_POST_HOOK=
# Host directory that receives the backups (default: ./backups)
# BACKUP_DIR=/mnt/backup-disk/predomics

# --------------------------------------------------------------------------
# Production proxy (advanced)
# --------------------------------------------------------------------------

# A load balancer / institutional proxy sits in front of the bundled NGINX:
# its address or CIDR, so that the client address and scheme it reports are
# used. Leave unset when NGINX is the entry point.
# NGINX_TRUSTED_PROXY=10.0.0.0/8

# Published ports of NGINX and the directory holding the certificates
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# CERTBOT_DIR=./certbot

# Container-name prefix, to run a second independent stack on the same host
# (also give it its own project name: docker compose -p <name> …)
# PREDOMICS_STACK=predomics

# --------------------------------------------------------------------------
# Base stack only (docker-compose.yml without the production override)
# --------------------------------------------------------------------------

# Host ports and bind address of the published app and database ports
# PREDOMICS_PORT=8001
# PREDOMICS_DB_PORT=5433
# PREDOMICS_BIND=127.0.0.1

# --------------------------------------------------------------------------
# Build (advanced): engine commits/tags to compile into the image.
# Defaults are pinned in the Dockerfile; override only to test another engine.
# --------------------------------------------------------------------------

# GPREDOMICS_REF=
# GPREDOMICSPY_REF=
